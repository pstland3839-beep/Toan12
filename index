<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App Ôn Tập Toán 12 - Oxyz</title>
    <style>
        :root { --primary: #2563eb; --bg: #f8fafc; --text: #1e293b; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: var(--text); padding: 20px; }
        .container { max-width: 700px; margin: auto; background: white; padding: 2rem; border-radius: 1rem; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        h1 { text-align: center; color: var(--primary); margin-bottom: 1.5rem; }
        .info-box { display: flex; gap: 10px; margin-bottom: 2rem; justify-content: center; }
        input[type="text"] { padding: 12px; border: 2px solid #e2e8f0; border-radius: 8px; width: 60%; outline: none; }
        input[type="text"]:focus { border-color: var(--primary); }
        .question { background: #fff; border: 1px solid #e2e8f0; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; transition: 0.2s; }
        .question:hover { border-color: var(--primary); }
        .options { display: grid; gap: 10px; margin-top: 10px; }
        .option { display: flex; align-items: center; padding: 10px; border: 1px solid #edf2f7; border-radius: 6px; cursor: pointer; }
        .option:hover { background: #f1f5f9; }
        .option input { margin-right: 12px; }
        .btn-submit { display: block; width: 100%; padding: 15px; background: var(--primary); color: white; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer; }
        #result { margin-top: 2rem; padding: 1.5rem; border-radius: 12px; display: none; text-align: center; }
        .leaderboard { margin-top: 3rem; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { padding: 12px; border-bottom: 1px solid #e2e8f0; text-align: left; }
        th { background: #f1f5f9; }
        .rank-1 { color: #d97706; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <h1>🎯 ÔN TẬP OXYZ TOÁN 12</h1>
    
    <div class="info-box">
        <input type="text" id="studentName" placeholder="Nhập họ và tên học sinh...">
    </div>

    <div id="quiz-content"></div>

    <button class="btn-submit" onclick="gradeQuiz()">Nộp Bài & Xem Thứ Hạng</button>

    <div id="result"></div>

    <div class="leaderboard">
        <h3>🏆 BẢNG XẾP HẠNG (TOP 10)</h3>
        <table id="leaderboardTable">
            <thead>
                <tr>
                    <th>Hạng</th>
                    <th>Tên</th>
                    <th>Điểm</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    const questions = [
        { q: "Cho A(1; 2; -1) và B(2; -1; 3). Tọa độ vectơ AB là:", a: ["(1; -3; 4)", "(-1; 3; -4)", "(3; 1; 2)", "(1; 1; 4)"], c: 0 },
        { q: "Vectơ nào là tổng của u=(1; 2; 3) và v=(2; 0; -1)?", a: ["(3; 2; 4)", "(3; 2; 2)", "(-1; 2; 4)", "(2; 0; -3)"], c: 1 },
        { q: "Phương trình mặt cầu tâm I(2; -1; 3), bán kính R=5 là:", a: ["(x-2)²+(y+1)²+(z-3)²=5", "(x+2)²+(y-1)²+(z+3)²=25", "(x-2)²+(y+1)²+(z-3)²=25", "x²+y²+z²=25"], c: 2 },
        { q: "Tâm J của mặt cầu đường kính MN với M(1;0;2), N(3;2;0) là:", a: ["(4; 2; 2)", "(2; 1; 1)", "(1; 1; -1)", "(2; 0; 1)"], c: 1 },
        { q: "Vectơ pháp tuyến của mặt phẳng (P): x - 2y + 2z - 5 = 0 là:", a: ["(1; 2; 2)", "(0; -2; 2)", "(-2; 2; -5)", "(1; -2; 2)"], c: 3 },
        { q: "Khoảng cách từ M(1; 2; -3) đến (P): x - 2y + 2z - 5 = 0 bằng:", a: ["14/3", "14/9", "4", "12/3"], c: 0 },
        { q: "Mặt phẳng qua M(1; 2; -3) và song song (P): x - 2y + 2z - 5 = 0 là:", a: ["x-2y+2z-9=0", "x-2y+2z+9=0", "x+2y-2z+9=0", "x-2y+2z+5=0"], c: 1 },
        { q: "Vectơ chỉ phương của d: (x-1)/2 = (y+2)/1 = z/-2 là:", a: ["(1; -2; 0)", "(2; 1; 2)", "(2; 1; -2)", "(-1; 2; 0)"], c: 2 },
        { q: "Đường thẳng qua A(2; 1; -1) và song song đường thẳng d ở Câu 8 có PTTS là:", a: ["x=2+2t; y=1+t; z=-1-2t", "x=1+2t; y=-2+t; z=-2t", "x=2+t; y=1-2t; z=-1", "x=2-2t; y=1-t; z=-1+2t"], c: 0 },
        { q: "Hình chiếu vuông góc của A(2; 1; -1) lên mặt phẳng (Oxy) là:", a: ["(0; 0; -1)", "(2; 0; 0)", "(0; 1; 0)", "(2; 1; 0)"], c: 3 }
    ];

    function initQuiz() {
        const quizContainer = document.getElementById('quiz-content');
        quizContainer.innerHTML = questions.map((item, i) => `
            <div class="question">
                <p><strong>Câu ${i + 1}:</strong> ${item.q}</p>
                <div class="options">
                    ${item.a.map((opt, idx) => `
                        <label class="option">
                            <input type="radio" name="q${i}" value="${idx}"> ${opt}
                        </label>
                    `).join('')}
                </div>
            </div>
        `).join('');
        renderLeaderboard();
    }

    function gradeQuiz() {
        const name = document.getElementById('studentName').value.trim();
        if (!name) return alert("Vui lòng nhập tên em nhé!");

        let score = 0;
        questions.forEach((item, i) => {
            const selected = document.querySelector(`input[name="q${i}"]:checked`);
            if (selected && parseInt(selected.value) === item.c) score++;
        });

        const finalScore = score; // Thang điểm 10
        const resultDiv = document.getElementById('result');
        resultDiv.style.display = 'block';
        resultDiv.style.background = score >= 5 ? '#dcfce7' : '#fee2e2';
        resultDiv.innerHTML = `<h3>Kết quả: ${finalScore}/10 điểm</h3><p>${score >= 8 ? "Giỏi lắm!" : score >= 5 ? "Khá tốt, cố gắng thêm nhé!" : "Em cần ôn tập kỹ hơn nhé!"}</p>`;

        saveScore(name, finalScore);
    }

    function saveScore(name, score) {
        let board = JSON.parse(localStorage.getItem('xyz_leaderboard')) || [];
        board.push({ name, score, date: new Date().getTime() });
        board.sort((a, b) => b.score - a.score || a.date - b.date);
        localStorage.setItem('xyz_leaderboard', JSON.stringify(board.slice(0, 10)));
        renderLeaderboard();
    }

    function renderLeaderboard() {
        const board = JSON.parse(localStorage.getItem('xyz_leaderboard')) || [];
        const tbody = document.querySelector('#leaderboardTable tbody');
        tbody.innerHTML = board.map((en, i) => `
            <tr>
                <td class="${i === 0 ? 'rank-1' : ''}">${i + 1}</td>
                <td>${en.name}</td>
                <td>${en.score}/10</td>
            </tr>
        `).join('');
    }

    window.onload = initQuiz;
</script>
</body>
</html>
